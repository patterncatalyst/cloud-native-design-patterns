FROM registry.access.redhat.com/ubi9/dotnet-100:9.8-1791421718 AS build
ENV NUGET_PACKAGES=/nuget-cache
WORKDIR /opt/app-root/src
COPY --chown=1001:0 StreamProcessor/StreamProcessor.csproj StreamProcessor/
RUN --mount=type=cache,target=/nuget-cache,uid=1001 dotnet restore StreamProcessor/StreamProcessor.csproj
COPY --chown=1001:0 StreamProcessor/ StreamProcessor/
RUN --mount=type=cache,target=/nuget-cache,uid=1001 dotnet publish StreamProcessor/StreamProcessor.csproj -c Release --no-restore -o /opt/app-root/app

FROM registry.access.redhat.com/ubi9/dotnet-100-aspnet:9.8-1791363520
COPY --from=build --chown=1001:0 --chmod=g=u /opt/app-root/app /opt/app-root/app
WORKDIR /opt/app-root/app
USER 1001
ENTRYPOINT ["dotnet", "StreamProcessor.dll"]
