# OpenTelemetry Java agent, downloaded from Maven Central and checked against a pinned SHA-256
# (the same value Maven Central publishes as opentelemetry-javaagent-2.32.0.jar.sha256).
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-15 AS otel-agent
ARG OTEL_AGENT_VERSION=2.32.0
ARG OTEL_AGENT_SHA256=f787eb6c7f3d18e69a431e108a15278d25ee37f83d68b678f621e063f3988f82
RUN curl -fsSL -o /tmp/opentelemetry-javaagent.jar \
      "https://repo1.maven.org/maven2/io/opentelemetry/javaagent/opentelemetry-javaagent/${OTEL_AGENT_VERSION}/opentelemetry-javaagent-${OTEL_AGENT_VERSION}.jar" \
 && echo "${OTEL_AGENT_SHA256}  /tmp/opentelemetry-javaagent.jar" | sha256sum -c -

FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-15 AS build
USER root
RUN microdnf install -y maven && microdnf clean all
USER default
WORKDIR /home/default
COPY pom.xml .
# Maven Central throttles bursts of fresh downloads (HTTP 429); retry with backoff.
ENV MAVEN_ARGS="-Daether.transport.http.retryHandler.count=8 -Daether.transport.http.retryHandler.interval=5000 -Daether.transport.http.retryHandler.serviceUnavailable=429,503"
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn dependency:go-offline -B
COPY src src
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn package -DskipTests -B

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-15
WORKDIR /deployments
COPY --from=build --chown=185:0 --chmod=g=u /home/default/target/*.jar app.jar
COPY --from=otel-agent --chown=185:0 --chmod=g=u /tmp/opentelemetry-javaagent.jar opentelemetry-javaagent.jar
ENV JAVA_TOOL_OPTIONS="-javaagent:/deployments/opentelemetry-javaagent.jar --enable-native-access=ALL-UNNAMED"
USER 185
CMD ["java", "-jar", "/deployments/app.jar"]
