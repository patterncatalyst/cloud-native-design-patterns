FROM registry.access.redhat.com/ubi10/openjdk-25 AS build

USER root
RUN microdnf install -y maven && microdnf clean all
USER default

WORKDIR /home/default
COPY pom.xml .
COPY src ./src

# Maven Central throttles bursts of fresh downloads (HTTP 429); retry with backoff.
ENV MAVEN_ARGS="-Daether.transport.http.retryHandler.count=8 -Daether.transport.http.retryHandler.interval=5000 -Daether.transport.http.retryHandler.serviceUnavailable=429,503"
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn package -DskipTests

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime

WORKDIR /deployments
COPY --from=build /home/default/target/quarkus-app/ ./

EXPOSE 8080
CMD ["java", "-jar", "quarkus-run.jar"]
