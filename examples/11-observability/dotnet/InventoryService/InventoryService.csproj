<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.*" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.*" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.*" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../proto/inventory.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
