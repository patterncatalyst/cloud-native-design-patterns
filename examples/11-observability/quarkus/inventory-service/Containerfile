FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-15 AS build
USER root
RUN microdnf install -y maven && microdnf clean all
USER default
RUN mkdir -p /home/default/build/inventory-service
WORKDIR /home/default/build/inventory-service
COPY inventory-service/pom.xml pom.xml
COPY proto/ ../proto/
# Maven Central throttles bursts of fresh downloads (HTTP 429); retry with backoff.
ENV MAVEN_ARGS="-Daether.transport.http.retryHandler.count=8 -Daether.transport.http.retryHandler.interval=5000 -Daether.transport.http.retryHandler.serviceUnavailable=429,503"
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn dependency:go-offline -B
COPY inventory-service/src src
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn package -DskipTests -B

FROM registry.access.redhat.com/ubi10/openjdk-25-runtime:1.24-15
WORKDIR /deployments
COPY --from=build --chown=185:0 --chmod=g=u /home/default/build/inventory-service/target/quarkus-app/ ./
USER 185
CMD ["java", "-jar", "quarkus-run.jar"]
