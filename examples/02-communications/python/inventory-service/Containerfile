FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217
USER 1001

COPY --chown=1001:0 --chmod=g=u inventory-service/requirements.txt .
RUN --mount=type=cache,target=/opt/app-root/src/.cache/pip,uid=1001 \
    PIP_NO_CACHE_DIR= PIP_DISABLE_PIP_VERSION_CHECK=1 pip install -r requirements.txt

COPY --chown=1001:0 --chmod=g=u proto/inventory.proto proto/inventory.proto
RUN python -m grpc_tools.protoc \
    -Iproto \
    --python_out=. \
    --grpc_python_out=. \
    proto/inventory.proto

COPY --chown=1001:0 --chmod=g=u inventory-service/ .
EXPOSE 50051
CMD ["python", "main.py"]
