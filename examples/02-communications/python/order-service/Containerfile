FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217
USER 1001

COPY --chown=1001:0 --chmod=g=u order-service/requirements.txt .
RUN --mount=type=cache,target=/opt/app-root/src/.cache/pip,uid=1001 \
    pip install -r requirements.txt

COPY --chown=1001:0 --chmod=g=u proto/inventory.proto proto/inventory.proto
RUN python -m grpc_tools.protoc \
    -Iproto \
    --python_out=. \
    --grpc_python_out=. \
    proto/inventory.proto

COPY --chown=1001:0 --chmod=g=u order-service/ .
EXPOSE 8080
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info"]
