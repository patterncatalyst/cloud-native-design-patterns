FROM registry.access.redhat.com/ubi9/dotnet-100:9.8-1791421718 AS build
ENV NUGET_PACKAGES=/nuget-cache
WORKDIR /opt/app-root/src
COPY --chown=1001:0 proto/ proto/
COPY --chown=1001:0 InventoryService/InventoryService.csproj InventoryService/
RUN --mount=type=cache,target=/nuget-cache,uid=1001 dotnet restore InventoryService/InventoryService.csproj
COPY --chown=1001:0 InventoryService/ InventoryService/
RUN --mount=type=cache,target=/nuget-cache,uid=1001 dotnet publish InventoryService/InventoryService.csproj -c Release --no-restore -o /opt/app-root/app

FROM registry.access.redhat.com/ubi9/dotnet-100-aspnet:9.8-1791363520
COPY --from=build --chown=1001:0 --chmod=g=u /opt/app-root/app /opt/app-root/app
WORKDIR /opt/app-root/app
EXPOSE 50051
USER 1001
ENTRYPOINT ["dotnet", "InventoryService.dll"]
