FROM registry.access.redhat.com/ubi9/openjdk-21 AS build
USER root
RUN microdnf install -y maven && microdnf clean all
USER default
WORKDIR /home/default
COPY order-api/pom.xml pom.xml
# Maven Central throttles bursts of fresh downloads (HTTP 429); retry with backoff.
ENV MAVEN_ARGS="-Daether.transport.http.retryHandler.count=8 -Daether.transport.http.retryHandler.interval=5000 -Daether.transport.http.retryHandler.serviceUnavailable=429,503"
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn dependency:go-offline -B
COPY order-api/src src
RUN --mount=type=cache,target=/home/default/.m2,uid=185 mvn package -DskipTests -B

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime
COPY --from=build /home/default/target/*.jar /deployments/app.jar
EXPOSE 8081
CMD ["java", "-jar", "/deployments/app.jar"]
