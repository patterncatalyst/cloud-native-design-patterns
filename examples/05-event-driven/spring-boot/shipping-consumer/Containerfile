FROM registry.access.redhat.com/ubi9/openjdk-21:latest AS build
USER root
RUN microdnf install -y maven && microdnf clean all
WORKDIR /build
COPY pom.xml .
# Maven Central throttles bursts of fresh downloads (HTTP 429); retry with backoff.
ENV MAVEN_ARGS="-Daether.transport.http.retryHandler.count=8 -Daether.transport.http.retryHandler.interval=5000 -Daether.transport.http.retryHandler.serviceUnavailable=429,503"
RUN --mount=type=cache,target=/root/.m2 mvn dependency:go-offline -B
COPY src/ src/
RUN --mount=type=cache,target=/root/.m2 mvn package -DskipTests -B

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:latest
COPY --from=build /build/target/*.jar /app/app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
