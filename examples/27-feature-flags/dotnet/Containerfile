FROM registry.access.redhat.com/ubi9/dotnet-100:9.8-1791421718 AS build
# Restore and publish share one RUN so the NuGet cache mount is always present when packages are used;
# sharing=locked keeps two images built in parallel from extracting into the same package directory.
ENV NUGET_PACKAGES=/nuget-cache
WORKDIR /opt/app-root/src
COPY --chown=1001:0 FlagService/ FlagService/
RUN --mount=type=cache,target=/nuget-cache,uid=1001,sharing=locked dotnet publish FlagService/FlagService.csproj -c Release -o /opt/app-root/app

FROM registry.access.redhat.com/ubi9/dotnet-100-aspnet:9.8-1791363520
COPY --from=build --chown=1001:0 --chmod=g=u /opt/app-root/app /opt/app-root/app
WORKDIR /opt/app-root/app
EXPOSE 8080
USER 1001
ENTRYPOINT ["dotnet", "FlagService.dll"]
