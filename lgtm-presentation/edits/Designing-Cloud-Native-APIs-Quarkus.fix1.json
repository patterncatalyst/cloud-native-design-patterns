    "// quarkus-kafka-streams: the topology is a CDI-produced bean",
    "@ApplicationScoped",
    "public class RevenueTopology {",
    "  @Produces",
    "  public Topology build() {",
    "    StreamsBuilder b = new StreamsBuilder();",
    "    var windowSerde = WindowedSerdes.timeWindowedSerdeFrom(String.class, 300_000L);",
    "    b.stream(\"order.placed\", Consumed.with(Serdes.String(), orderSerde))",
    "     .groupBy((k, o) -> o.merchantId())",
    "     .windowedBy(TimeWindows.ofSizeWithNoGrace(Duration.ofMinutes(5)))",
    "     .aggregate(() -> 0.0,                            // local, changelog-backed",
    "                (mId, o, total) -> total + o.total(),",
    "                Materialized.as(\"revenue-by-merchant\"))  // state store",
    "     .toStream()",
    "     .to(\"revenue.by-merchant\", Produced.with(windowSerde, Serdes.Double()));",
    "    return b.build();",
    "  }",
    "}"
   ],
   "cat": "code",
   "_why": "Kafka Streams: the windowed Double result needs explicit serdes on .to(...)",
